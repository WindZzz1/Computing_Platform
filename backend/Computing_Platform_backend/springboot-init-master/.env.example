# 数据库配置
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/graduation_achievement?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_password_here

# Redis 配置
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# Elasticsearch 配置
SPRING_ELASTICSEARCH_REST_URIS=http://localhost:9200

# JWT 配置
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_secure
JWT_EXPIRATION=86400000

# 文件上传配置
FILE_UPLOAD_PATH=/path/to/upload/directory
FILE_MAX_SIZE=10485760

# 阿里云配置（如果使用）
ALIYUN_OSS_BUCKET_NAME=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=

# 应用配置
SERVER_PORT=8101
APP_NAME=Computing Platform Backend
APP_VERSION=1.0.0

# 日志配置
LOG_LEVEL=INFO
LOG_PATH=/path/to/logs
