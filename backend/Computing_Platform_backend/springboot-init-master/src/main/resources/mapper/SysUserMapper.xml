<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yupi.springbootinit.mapper.SysUserMapper">

    <resultMap id="BaseResultMap" type="generator.domain.SysUser">
            <id property="id" column="id" />
            <result property="username" column="username" />
            <result property="password" column="password" />
            <result property="role_code" column="role_code" />
            <result property="college_id" column="college_id" />
            <result property="status" column="status" />
            <result property="create_time" column="create_time" />
            <result property="update_time" column="update_time" />
            <result property="is_deleted" column="is_deleted" />
    </resultMap>

    <resultMap id="SysUserVOResultMap" type="com.yupi.springbootinit.model.vo.SysUserVO">
            <id property="id" column="id" />
            <result property="username" column="username" />
            <result property="roleCode" column="roleCode" />
            <result property="collegeName" column="collegeName" />
            <result property="status" column="status" />
            <result property="createTime" column="createTime" />
    </resultMap>

    <sql id="Base_Column_List">
        id,username,password,role_code,college_id,status,
        create_time,update_time,is_deleted
    </sql>

    <select id="selectUserWithCollege" resultMap="SysUserVOResultMap">
        SELECT u.id,
               u.username,
               u.role_code as roleCode,
               c.college_name as collegeName,
               u.status,
               u.create_time as createTime
        FROM sys_user u
        LEFT JOIN sys_dict_college c ON u.college_id = c.id
        WHERE u.username = #{username}
          AND u.password = #{password}
          AND u.is_deleted = 0
    </select>

    <select id="selectUserVOById" resultMap="SysUserVOResultMap">
        SELECT u.id,
               u.username,
               u.role_code as roleCode,
               c.college_name as collegeName,
               u.status,
               u.create_time as createTime
        FROM sys_user u
        LEFT JOIN sys_dict_college c ON u.college_id = c.id
        WHERE u.id = #{userId}
          AND u.is_deleted = 0
    </select>

</mapper>
